<!--=========================================
PROYECTO: ProyectoRutinas
ARCHIVO: Rutina.cshtml

MÓDULO:
Interfaz de Usuario

DESCRIPCIÓN:
Vista que presenta una rutina de entrenamiento
de ejemplo para los visitantes del sistema.

RESPONSABILIDAD:
Permitir que el usuario conozca el contenido
que ofrece la aplicación e invitarlo a crear
una cuenta para acceder a las funciones del
sistema.
==========================================-->

@{
    ViewBag.Title = "Rutina de Entrenamiento";
}

<div class="container mt-4">

    <!--=========================================
        TÍTULO
    ==========================================-->

    <h2 class="text-center">
        Explora una rutina de ejemplo
    </h2>

    <hr />

    <!--=========================================
        DESCRIPCIÓN
    ==========================================-->

    <div class="row align-items-center">

        <!-- Texto -->
        <div class="col-md-9">

            <p>
                Esta sección te permite conocer una muestra de las rutinas disponibles
                en <strong>Fit Rutinas</strong>. Selecciona un grupo muscular para visualizar
                un ejemplo de entrenamiento.
            </p>

            <p>
                Si deseas acceder a todas las rutinas, crear planes personalizados y
                llevar el seguimiento de tu progreso, será necesario registrarte.
            </p>

        </div>

        <!-- Logotipo -->
        <div class="col-md-3">
            <img src="@Url.Content("~/Documentacion/Logotipo.jpg")"
                 alt="Logotipo del Sistema"
                 style="max-width:180px;
                    width:100%;
                    height:auto;
                     margin-top:-20px;"
                 margin-top:-20px; />

        </div>
    </div>


    <!--=========================================
        DEMOSTRACIÓN DE RUTINAS
    ==========================================-->

    <div class="row justify-content-center align-items-start gx-4"
         style="max-width:1400px; margin:0 auto;">


        <!--=========================================
            PANEL IZQUIERDO
        ==========================================-->

        <div class="col-md-4">

            <br />
            <h3>¿Qué parte del cuerpo deseas entrenar?</h3>
            <hr />

            <select id="grupoMuscular" class="form-control">
                <option value="">-- Selecciona una opción --</option>
                <option value="pecho">Pecho</option>
                <option value="espalda">Espalda</option>
                <option value="piernas">Piernas</option>
                <option value="hombros">Hombros</option>
                <option value="biceps">Bíceps</option>
                <option value="triceps">Tríceps</option>
                <option value="abdomen">Abdomen</option>
            </select>

            <br />

            <button type="button"
                    onclick="mostrarRutina()">
                Mostrar Rutina
            </button>

        </div>

        <!--=========================================
            PANEL DERECHO
        ==========================================-->

        <div class="col-md-5 ms-md-5">
            <br />

            <h3>Rutina:</h3>
            <hr />

            <!--=========================================
                RESULTADO
            ==========================================-->

            <div id="resultado">

            </div>

        </div>

    </div>
    <br />
    <hr />


    <!--=========================================
        INVITACIÓN A REGISTRARSE
    ==========================================-->

    <div class="text-center">

        <h3>
            <p>
                <strong>
                    Las rutinas mostradas corresponden únicamente a una demostración.

                </strong>
            </p>
        </h3>
        <br />

        <h4>
            <p>
                Regístrate para acceder al catálogo completo de entrenamientos,
                crear rutinas personalizadas y utilizar todas las funciones del sistema.
            </p>
        </h4>
        <br />

        <button type="button"
                onclick="location.href='@Url.Action("Register","Account")'">
            Registrarse
        </button>

    </div>

    <hr />

</div>

<script>

    function mostrarRutina() {

        var grupo = document.getElementById("grupoMuscular").value;
        var resultado = document.getElementById("resultado");

        var rutinas = {

            pecho: `
            <h3>Pecho</h3>
            <ul>
                <li>Press de banca - 4 x 10</li>
                <li>Press inclinado - 3 x 12</li>
                <li>Aperturas con mancuernas - 3 x 15</li>
                <li>Fondos - 3 x 12</li>
            </ul>`,

            espalda: `
            <h3>Espalda</h3>
            <ul>
                <li>Dominadas - 4 x 8</li>
                <li>Remo con barra - 4 x 10</li>
                <li>Jalón al pecho - 3 x 12</li>
                <li>Peso muerto - 3 x 8</li>
            </ul>`,

            piernas: `
            <h3>Piernas</h3>
            <ul>
                <li>Sentadilla - 4 x 10</li>
                <li>Prensa - 3 x 12</li>
                <li>Peso muerto rumano - 3 x 10</li>
                <li>Extensión de piernas - 3 x 15</li>
            </ul>`,

            hombros: `
            <h3>Hombros</h3>
            <ul>
                <li>Press militar - 4 x 10</li>
                <li>Elevaciones laterales - 3 x 15</li>
                <li>Elevaciones frontales - 3 x 12</li>
                <li>Pájaros - 3 x 15</li>
            </ul>`,

            biceps: `
            <h3>Bíceps</h3>
            <ul>
                <li>Curl con barra - 4 x 10</li>
                <li>Curl martillo - 3 x 12</li>
                <li>Curl concentrado - 3 x 12</li>
            </ul>`,

            triceps: `
            <h3>Tríceps</h3>
            <ul>
                <li>Fondos - 4 x 10</li>
                <li>Extensión en polea - 3 x 12</li>
                <li>Press francés - 3 x 10</li>
            </ul>`,

            abdomen: `
            <h3>Abdomen</h3>
            <ul>
                <li>Crunch - 3 x 20</li>
                <li>Elevación de piernas - 3 x 15</li>
                <li>Plancha - 3 x 45 segundos</li>
            </ul>`
        };

        if (grupo == "") {

            resultado.innerHTML = `
                <p><strong>Selecciona un grupo muscular.</strong></p>
            `;

        } else {

            resultado.innerHTML = rutinas[grupo];

        }

    }

</script>
